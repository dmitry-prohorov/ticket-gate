{
  "name": "ticket-gate-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ticket-gate-workspace",
      "workspaces": [
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@ticket-gate/engine": {
      "resolved": "packages/engine",
      "link": true
    },
    "node_modules/@ticket-gate/supabase-next": {
      "resolved": "packages/supabase-next",
      "link": true
    },
    "packages/engine": {
      "name": "@ticket-gate/engine",
      "version": "0.1.0-rc.1",
      "license": "Apache-2.0",
      "bin": {
        "ticket-gate": "bin/ticket-gate.mjs"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "packages/supabase-next": {
      "name": "@ticket-gate/supabase-next",
      "version": "0.1.0-rc.1",
      "license": "Apache-2.0",
      "dependencies": {
        "@ticket-gate/engine": "0.1.0-rc.1"
      },
      "engines": {
        "node": ">=22"
      }
    }
  }
}
