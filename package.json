{
  "name": "ticket-gate-workspace",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test \"packages/*/test/**/*.test.mjs\" \"test/**/*.test.mjs\" \"scripts/*.test.mjs\"",
    "scrub": "node scripts/scrub.mjs",
    "mutate": "node scripts/mutations.mjs mutate",
    "mutations:check": "node scripts/mutations.mjs mutations check",
    "check": "pnpm test && pnpm run scrub && pnpm run mutations:check",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@playwright/test": "1.63.0",
    "babel-plugin-react-compiler": "1.0.0",
    "jscpd": "4.3.0",
    "typescript": "5.9.3"
  }
}
